# Production settings for Toilet Map v2.
# Copy this file to .env and fill in real values before deploying.
# Never commit secrets to the repository.

# Database
DATABASE_URL=postgresql://user:password@host:5432/toilet_map

# Admin API key (generate a strong random value)
ADMIN_API_KEY=change-me-to-a-random-secret

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=https://your-frontend-domain.example.com

# Frontend API base URL (must be the public backend URL)
NEXT_PUBLIC_API_BASE_URL=https://your-backend-domain.example.com

# Read model — "snapshot" for production, "places" for rollback
PUBLIC_READ_MODEL=snapshot
